# Copy to `.env` (never commit `.env`). Both the backend and the Vite build read this file.

# Environment: "development" or "production". Production enables Secure cookies and hides API docs.
APP_ENV=development

# SQLite database location. Relative paths are resolved from the backend/ folder.
DATABASE_URL=sqlite:///./data/forever_star.db

# REQUIRED. Random secret (32+ chars) used to sign sessions and to protect Registry Codes.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing this later invalidates stored Registry Codes - keep it backed up.
SECRET_KEY=

# Admin login. ADMIN_PASSWORD_HASH is the INITIAL password, set by the developer (never put a plaintext
# password here). Generate the hash with:  python scripts/hash_password.py
# Once the admin changes the password in Admin > Change password, the new hash is stored in the database
# and takes over; this value is then ignored. Emergency reset: python scripts/reset_admin_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Where certificate files are stored (relative to backend/). Never put these in the database.
UPLOAD_DIR=./uploads

# Maximum certificate upload size in megabytes.
MAX_CERTIFICATE_MB=5

# Official Instagram profile used by all "Dedicate a Star" / contact buttons (build-time for the frontend).
INSTAGRAM_URL=https://www.instagram.com/your_forever_star_handle/

# Comma-separated origins allowed to call the API with cookies (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Set to true ONLY behind a trusted reverse proxy (Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=false

# ---- Optional: hosting / staging (leave unset for normal local development) ----
# Header carrying the real client IP when TRUST_PROXY=true. Default x-forwarded-for (rightmost entry is trusted);
# on Render use CF-Connecting-IP.
# CLIENT_IP_HEADER=x-forwarded-for
# Serve the built React app from FastAPI (single-service hosting, set by the Docker image).
# FRONTEND_DIST=../frontend/dist
# Send X-Robots-Tag: noindex and a Disallow-all robots.txt (staging).
# NOINDEX=true
# Staging only: restore the existing test records on every start (see README, "Render staging").
# STAGING_SEED_FILE=/etc/secrets/staging_seed.json
# STAGING_SEED_B64=
